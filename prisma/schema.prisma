datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String    @default("Vendor Administrator")
  passwordHash           String
  
  // Multi-Factor Authentication (2FA / 3FA)
  two_factor_secret      String?
  two_factor_enabled     Boolean   @default(false)
  two_factor_temp_secret String?   // Temporary secret during setup before verification
  
  // 3rd Verification Layer: IP Whitelisting
  allowed_ips            String?   @default("127.0.0.1,::1,localhost") // Comma-separated or JSON list of authorized IPs/CIDRs
  ip_whitelist_enabled    Boolean   @default(false)
  
  // Backup & Recovery OTPs
  backup_codes           String?   // JSON array of hashed recovery codes
  
  // SMS 2FA Support
  phone                  String?   @default("+8801700000000")
  phone_verified         Boolean   @default(false)
  sms_otp_code           String?
  sms_otp_expires_at     DateTime?
  preferred_2fa_method   String    @default("totp") // "totp" | "sms"
  
  lastLoginAt            DateTime?
  lastLoginIp            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([email])
}

model Client {
  id                  String         @id @default(cuid())
  clientCode          String         @unique // e.g. CLI-MADRASA-001
  name                String         // Institution name / Organization
  contactPerson       String?
  email               String?
  phone               String?
  domain              String?        // e.g. madrasa1.edu.bd
  appType             String         @default("Madrasa/School Management")
  status              String         @default("ACTIVE") // ACTIVE, BLOCKED, SUSPENDED, EXPIRED, PENDING
  secretKey           String         @unique // API secret for client auth & remote calls
  
  // Licensing & Validity
  licenseCategory     String         @default("APP_LICENSE") // APP_LICENSE, HOSTING_RENEWAL, DOMAIN_RENEWAL, STUDENT_QUOTA_UPGRADE, TRIAL
  isLifetime          Boolean        @default(false)
  isTrial             Boolean        @default(false)
  trialEndsAt         DateTime?
  gracePeriodHours    Int            @default(48) // 48-hour offline grace period before suspension
  licenseExpiresAt    DateTime?
  hostingExpiresAt    DateTime?
  domainExpiresAt     DateTime?
  
  // Quota & Limits
  studentQuota        Int            @default(200) // Default baseline student limit
  storageQuotaGb      Float          @default(5.0)
  
  // Security & 2FA / IP Whitelist
  two_factor_secret   String?
  two_factor_enabled  Boolean        @default(false)
  allowed_ips         String?
  
  // Live Tracking / Heartbeat
  lastHeartbeatAt     DateTime?
  last_sync           DateTime?
  live_status         String?        @default("OFFLINE") // ONLINE, OFFLINE, WARNING, BLOCKED
  lastPingIp          String?
  lastAppVersion      String?
  lastStatusReported  String?
  isOnline            Boolean        @default(false)
  
  // Relations
  assignedCodes       LicenseCode[]  @relation("AssignedClient")
  redeemedCodes       LicenseCode[]  @relation("RedeemedClient")
  ledgerEntries       VendorLedger[]
  heartbeats          HeartbeatLog[]
  quotas              AppQuota?
  
  metadata            String?        // JSON formatted extra configs / client params
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status])
  @@index([clientCode])
  @@index([isTrial])
}

model LicenseCode {
  id                  String         @id @default(cuid())
  code                String         @unique // e.g. SAAS-7K9P-4M2X-8W1Q
  category            String         @default("APP_LICENSE") // APP_LICENSE, HOSTING_RENEWAL, DOMAIN_RENEWAL, STUDENT_QUOTA_UPGRADE
  validityType        String         @default("YEARS_1") // YEARS_1 to YEARS_12, LIFETIME, QUOTA_CREDITS
  validityYears       Int?           // 1 to 12 (null if Lifetime or Quota)
  isLifetime          Boolean        @default(false)
  
  // Quota Specific (for STUDENT_QUOTA_UPGRADE)
  quotaCredits        Int?           // e.g. 1000 credits
  studentQuotaAdded   Int?           // e.g. 100 students (10 credits = 1 student)
  
  // Financial & Pricing
  priceBdt            Float          @default(0.0) // 1000 credits = 2000 BDT
  
  // Lifecycle Status
  status              String         @default("AVAILABLE") // AVAILABLE, ASSIGNED, USED, REVOKED, EXPIRED
  batchId             String?
  batch               BatchGeneration? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  
  // Assignment & Redemption
  assignedClientId    String?
  assignedClient      Client?        @relation("AssignedClient", fields: [assignedClientId], references: [id], onDelete: SetNull)
  
  redeemedClientId    String?
  redeemedClient      Client?        @relation("RedeemedClient", fields: [redeemedClientId], references: [id], onDelete: SetNull)
  redeemedAt          DateTime?
  redeemedByIp        String?
  
  // Optional expiry of the code itself before activation
  expiresAt           DateTime?
  note                String?
  
  ledgerEntries       VendorLedger[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([code])
  @@index([status])
  @@index([category])
  @@index([batchId])
}

model AppQuota {
  id                  String         @id @default(cuid())
  clientId            String         @unique
  client              Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  // Student Quotas
  baseStudents        Int            @default(200)
  extraStudents       Int            @default(0)
  totalStudents       Int            @default(200)
  usedStudents        Int            @default(0)
  
  // Credit & Financials
  totalCreditsPurchased Int          @default(0)
  totalCreditsUsed      Int          @default(0)
  availableCredits      Int          @default(0)
  
  // Features / Addons
  smsCredits          Int            @default(0)
  storageMb           Int            @default(5120) // 5GB
  
  lastUpdated         DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model VendorLedger {
  id                  String          @id @default(cuid())
  clientId            String
  client              Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  transactionType     String          // BILLING, REDEMPTION, PAYMENT, ADJUSTMENT
  amountBdt           Float           // Positive for billings/dues, negative for payments received
  creditAmount        Float           @default(0.0) // Amount paid/credited
  debitAmount         Float           @default(0.0) // Amount billed/debited
  runningBalanceBdt   Float           @default(0.0) // Positive = client owes money (Due)
  
  description         String
  referenceCodeId     String?
  referenceCode       LicenseCode?    @relation(fields: [referenceCodeId], references: [id], onDelete: SetNull)
  
  paymentMethod       String?         // bKash, Nagad, Bank Transfer, Cash, Pre-paid Code
  receiptNumber       String?
  performedBy         String?         @default("SYSTEM")
  
  createdAt           DateTime        @default(now())

  @@index([clientId])
  @@index([transactionType])
  @@index([createdAt])
}

model HeartbeatLog {
  id                  String         @id @default(cuid())
  clientId            String
  client              Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  ipAddress           String?
  appVersion          String?
  domainReported      String?
  statusReported      String?        // Reported internal status by client app
  activeStudentsCount Int?
  databaseSizeMb      Float?
  
  responseDirectives  String?        // JSON containing directives sent back (e.g. KILLSWITCH, SYNC_QUOTA)
  createdAt           DateTime       @default(now())

  @@index([clientId])
  @@index([createdAt])
}

model BatchGeneration {
  id                  String         @id @default(cuid())
  batchNumber         String         @unique // e.g. BATCH-202609-001
  name                String         // e.g. Madrasa 2026 Batch Quotas
  category            String         // APP_LICENSE, HOSTING_RENEWAL, DOMAIN_RENEWAL, STUDENT_QUOTA_UPGRADE
  validityType        String         // YEARS_1 to YEARS_12, LIFETIME, QUOTA_CREDITS
  validityYears       Int?
  isLifetime          Boolean        @default(false)
  
  quotaCredits        Int?
  studentQuotaAdded   Int?
  
  quantity            Int
  priceBdtPerUnit     Float
  totalValueBdt       Float
  
  codes               LicenseCode[]
  generatedBy         String         @default("Vendor Admin")
  notes               String?
  createdAt           DateTime       @default(now())

  @@index([batchNumber])
  @@index([category])
}

model License {
  id             String    @id @default(cuid())
  client_name    String
  license_key    String    @unique // e.g. VEND-XXXX-XXXX-XXXX-XXXX
  mac_address    String?
  expiry_date    DateTime?
  status         String    @default("Active") // Active, Suspended, Expired, Blocked
  last_heartbeat DateTime?
  last_sync      DateTime?
  live_status    String?   @default("OFFLINE") // ONLINE, OFFLINE, WARNING, BLOCKED
  ip_address     String?
  app_version    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([license_key])
  @@index([status])
  @@index([client_name])
}

model SecurityAlert {
  id          String   @id @default(cuid())
  type        String   // FAILED_2FA, UNAUTHORIZED_IP, HARDWARE_MISMATCH, INVALID_CREDENTIALS, KILLSWITCH_TRIGGERED
  severity    String   @default("HIGH") // CRITICAL, HIGH, MEDIUM, LOW
  title       String
  description String
  ipAddress   String?
  clientCode  String?
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([resolved])
}

